# Copy to .env and adjust for your environment.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Bishkek

# Leave unset to use local sqlite. Point at PostgreSQL in staging/production:
# DATABASE_URL=postgres://klara:klara@localhost:5432/klara

DEFAULT_CURRENCY=KGS
CHEESECAKE_MIN_LEAD_HOURS=48
FRONTEND_BASE_URL=http://localhost:3000

DJANGO_CORS_ALLOW_ALL=1
